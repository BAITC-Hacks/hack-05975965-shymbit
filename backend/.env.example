PORT=3000
DB_FILE=./data/db.json

# Пустые значения сохраняют локальный JSON-режим. В production обязательна PostgreSQL.
STORAGE_DRIVER=
DATABASE_URL=
# verify-full — внешний адрес с проверкой сертификата; require — TLS внутреннего Render;
# disable — только локальная тестовая PostgreSQL без TLS.
DB_SSL_MODE=verify-full
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# В production укажите HTTPS-адрес frontend без завершающего слеша.
CORS_ORIGINS=

# AI API обязателен для уточнения, генерации карточки и AI-планов.
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# Только за доверенным reverse proxy: число прокси до приложения, например 1.
# Локально оставьте пустым; не включайте доверие к произвольным X-Forwarded-For.
TRUST_PROXY_HOPS=
AI_REQUEST_LIMIT=10
AI_CONCURRENCY=2
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_PAGES=50
IMPORT_MAX_CHARS=50000
IMPORT_TIMEOUT_MS=10000
